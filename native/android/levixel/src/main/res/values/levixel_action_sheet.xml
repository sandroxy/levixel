<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Levixel.ActionSheet.Light" parent="Levixel.ActionSheet.Base" />
    <style name="Levixel.ActionSheet.Base" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Levixel.ActionSheet.Surface</item>
        <item name="colorSurface">#DEDEDE</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.4</item>
    </style>
    <style name="Levixel.ActionSheet.Surface" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/Levixel.ActionSheet.Corners</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="paddingLeftSystemWindowInsets">false</item>
        <item name="paddingRightSystemWindowInsets">false</item>
    </style>
    <style name="Levixel.ActionSheet.Corners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
