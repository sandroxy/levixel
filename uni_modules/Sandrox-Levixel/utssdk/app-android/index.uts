import {
  CloseLevixelNative,
  LevixelNativeCallback,
  OnLevixelNativeEvent,
  OpenLevixelNative,
  ResolveLevixelNativePaths,
} from '../interface.uts'
import LevixelUniJsonCallback from 'com.sandrox.levixel.uniapp.runtime.LevixelUniJsonCallback'
import LevixelUniJsonEventListener from 'com.sandrox.levixel.uniapp.runtime.LevixelUniJsonEventListener'
import LevixelUniRuntime from 'com.sandrox.levixel.uniapp.runtime.LevixelUniRuntime'

class RuntimeResultCallback implements LevixelUniJsonCallback {
  private callback: LevixelNativeCallback

  constructor(callback: LevixelNativeCallback) {
    this.callback = callback
  }

  override onResult(resultJson: string): void {
    this.callback(resultJson)
  }
}

class RuntimeEventListener implements LevixelUniJsonEventListener {
  private callback: LevixelNativeCallback

  constructor(callback: LevixelNativeCallback) {
    this.callback = callback
  }

  override onEvent(eventJson: string): void {
    this.callback(eventJson)
  }
}

let destroyHookRegistered = false

function ensureDestroyHook(): void {
  if (destroyHookRegistered)
    return
  destroyHookRegistered = true
  UTSAndroid.onAppActivityDestroy(() => {
    LevixelUniRuntime.getShared().closeImmediately()
    LevixelUniRuntime.getShared().setJsonEventListener(null)
  })
}

export const openLevixelNative: OpenLevixelNative = function (
  optionsJson: string,
  callback: LevixelNativeCallback
): void {
  ensureDestroyHook()
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    callback('{"ok":false,"code":"NO_ACTIVITY","path":"$","message":"Unable to find the current Activity"}')
    return
  }
  LevixelUniRuntime.getShared().openJson(
    activity,
    optionsJson,
    new RuntimeResultCallback(callback)
  )
}

export const closeLevixelNative: CloseLevixelNative = function (
  optionsJson: string,
  callback: LevixelNativeCallback
): void {
  LevixelUniRuntime.getShared().closeJson(
    optionsJson,
    new RuntimeResultCallback(callback)
  )
}

export const onLevixelNativeEvent: OnLevixelNativeEvent = function (
  callback: LevixelNativeCallback
): void {
  ensureDestroyHook()
  const listener = new RuntimeEventListener(callback)
  LevixelUniRuntime.getShared().setJsonEventListener(listener)
}

function shouldPreservePath(path: string): boolean {
  const lowerPath = path.toLowerCase()
  if (lowerPath.startsWith('http://')
    || lowerPath.startsWith('https://')
    || lowerPath.startsWith('data:')
    || lowerPath.startsWith('file:')
    || lowerPath.startsWith('blob:'))
    return true
  const schemeSeparator = lowerPath.indexOf('://')
  return schemeSeparator > 0 && !lowerPath.startsWith('unifile://')
}

function codePackageResourcePath(path: string): string {
  const resourcePath = path.startsWith('/')
    ? path.substring(1)
    : path
  if (resourcePath.startsWith('static/'))
    return resourcePath
  if (!resourcePath.startsWith('uni_modules/'))
    return ''
  const staticSegment = resourcePath.indexOf('/static/')
  return staticSegment > 'uni_modules/'.length ? resourcePath : ''
}

function resolveNativePath(path: string): string {
  const normalizedPath = path.trim()
  if (normalizedPath.length == 0 || shouldPreservePath(normalizedPath))
    return path

  let resolvedPath = path
  try {
    const resourcePath = codePackageResourcePath(normalizedPath)
    if (resourcePath.length > 0) {
      resolvedPath = UTSAndroid.getResourcePath(resourcePath)
    }
    else {
      resolvedPath = UTSAndroid.convert2AbsFullPath(normalizedPath)
    }
  }
  catch (error) {
    resolvedPath = path
  }
  return resolvedPath.length > 0 ? resolvedPath : path
}

export const resolveLevixelNativePaths: ResolveLevixelNativePaths = function (
  pathsJson: string,
  callback: LevixelNativeCallback
): void {
  let paths: string[]
  try {
    paths = JSON.parse<string[]>(pathsJson)!
  }
  catch (error) {
    callback('[]')
    return
  }

  const resolvedPaths: string[] = []
  paths.forEach((path: string) => {
    resolvedPaths.push(resolveNativePath(path))
  })
  callback(JSON.stringify(resolvedPaths)!)
}
