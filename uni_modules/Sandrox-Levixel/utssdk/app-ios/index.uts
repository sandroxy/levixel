import {
  CloseLevixelNative,
  LevixelNativeCallback,
  OnLevixelNativeEvent,
  OpenLevixelNative,
  ResolveLevixelNativePaths,
} from '../interface.uts'
import { LevixelUniPresenter } from 'LevixelUniRuntime'

export const openLevixelNative: OpenLevixelNative = function (
  optionsJson: string,
  callback: LevixelNativeCallback
): void {
  LevixelUniPresenter.shared.openJSON(
    optionsJson,
    rootView = null,
    viewController = null,
    completion = (resultJson: string) => {
      callback(resultJson)
    }
  )
}

export const closeLevixelNative: CloseLevixelNative = function (
  optionsJson: string,
  callback: LevixelNativeCallback
): void {
  LevixelUniPresenter.shared.closeJSON(
    optionsJson,
    completion = (resultJson: string) => {
      callback(resultJson)
    }
  )
}

export const onLevixelNativeEvent: OnLevixelNativeEvent = function (
  callback: LevixelNativeCallback
): void {
  LevixelUniPresenter.shared.setJSONEventHandler((eventJson: string) => {
    callback(eventJson)
  })
}

function shouldPreservePath(path: string): boolean {
  const lowerPath = path.toLowerCase()
  if (lowerPath.startsWith('http://')
    || lowerPath.startsWith('https://')
    || lowerPath.startsWith('data:')
    || lowerPath.startsWith('file:')
    || lowerPath.startsWith('blob:'))
    return true
  const schemeSeparator = lowerPath.indexOf('://')
  return schemeSeparator > 0 && !lowerPath.startsWith('unifile://')
}

function resolveNativePath(path: string): string {
  const normalizedPath = path.trim()
  if (normalizedPath.length == 0 || shouldPreservePath(normalizedPath))
    return path

  let resolvedPath = path
  try {
    resolvedPath = UTSiOS.convert2AbsFullPath(normalizedPath)
  }
  catch (error) {
    resolvedPath = path
  }
  return resolvedPath.length > 0 ? resolvedPath : path
}

export const resolveLevixelNativePaths: ResolveLevixelNativePaths = function (
  pathsJson: string,
  callback: LevixelNativeCallback
): void {
  let paths: string[]
  try {
    paths = JSON.parse<string[]>(pathsJson)!
  }
  catch (error) {
    callback('[]')
    return
  }

  const resolvedPaths: string[] = []
  paths.forEach((path: string) => {
    resolvedPaths.push(resolveNativePath(path))
  })
  callback(JSON.stringify(resolvedPaths)!)
}
