{
  "name": "Levixel shared-transition viewer",
  "id": "Sandrox-Levixel",
  "version": "@VERSION@",
  "description": "Shared-transition image and video viewer bridge for UniApp on Android and iOS.",
  "_dp_type": "nativeplugin",
  "_dp_nativeplugin": {
    "android": {
      "plugins": [
        {
          "type": "module",
          "name": "Sandrox-Levixel",
          "class": "com.sandrox.levixel.uniapp.LevixelUniModule"
        }
      ],
      "integrateType": "aar",
      "dependencies": [
        "androidx.appcompat:appcompat:1.7.1",
        "androidx.recyclerview:recyclerview:1.4.0",
        "androidx.viewpager2:viewpager2:1.1.0",
        "androidx.core:core:1.15.0",
        "com.github.bumptech.glide:glide:4.16.0",
        "androidx.media3:media3-exoplayer:1.5.1",
        "androidx.media3:media3-ui:1.5.1"
      ],
      "compileOptions": {
        "sourceCompatibility": "1.8",
        "targetCompatibility": "1.8"
      },
      "abis": [
        "armeabi-v7a",
        "arm64-v8a"
      ],
      "minSdkVersion": "21"
    },
    "ios": {
      "plugins": [
        {
          "type": "module",
          "name": "Sandrox-Levixel",
          "class": "LevixelUniModule"
        }
      ],
      "integrateType": "framework",
      "deploymentTarget": "13.0",
      "frameworks": [
        "LevixelUniApp.framework",
        "Levixel.framework",
        "AVFoundation.framework",
        "AVKit.framework"
      ],
      "embedFrameworks": [
        "Levixel.framework"
      ],
      "resources": [],
      "validArchitectures": [
        "arm64"
      ]
    }
  }
}
