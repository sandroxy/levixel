{
  "name": "@sandrox/levixel-web",
  "version": "0.0.0-development",
  "description": "Framework-independent Levixel shared-transition image and video viewer for Web.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "sandrox",
  "homepage": "https://github.com/sandroxy/levixel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandroxy/levixel.git",
    "directory": "adapters/web"
  },
  "bugs": {
    "url": "https://github.com/sandroxy/levixel/issues"
  },
  "keywords": [
    "gallery",
    "image-viewer",
    "shared-transition",
    "video-viewer",
    "web"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "vite demo --host 127.0.0.1",
    "dev:device": "vite demo --host 0.0.0.0",
    "test": "npm run build && node --test tests/contract.test.mjs tests/geometry.test.mjs && node tests/browser.test.mjs",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "playwright-core": "^1.55.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.3"
  },
  "sideEffects": false
}
